{
    "name": "synergitech/laravel-docblocks",
    "description": "Automatically generate PHPDoc types for various elements within Laravel project.",
    "keywords": [
        "laravel",
        "eloquent",
        "phpstan",
        "phpdoc",
        "static-analysis"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "SynergiTech\\LaravelDocblocks\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SynergiTech\\LaravelDocblocks\\LaravelDocblocksServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
